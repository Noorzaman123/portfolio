# Copy this file to .env and fill in your values
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (leave blank to use SQLite)
DATABASE_URL=sqlite:///portfolio.db

# Admin credentials (used by seed_db.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=noorzamanktk2@gmail.com
ADMIN_PASSWORD=Admin@Portfolio2024

# Email / SMTP (optional - for contact form notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
CONTACT_NOTIFY_EMAIL=noorzamanktk2@gmail.com
